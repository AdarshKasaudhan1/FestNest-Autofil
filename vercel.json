{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,data/dataset/**,data/debug/**,data/screenshots/**,notebooks/**,04_finetune_lora_colab.ipynb,*.zip,models/**}"
    }
  }
}
